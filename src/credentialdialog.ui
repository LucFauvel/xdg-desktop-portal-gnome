<?xml version="1.0" encoding="UTF-8"?>
<interface domain="xdg-desktop-portal-gnome">
  <requires lib="gtk" version="4.0"/>
  <template class="CredentialDialog" parent="AdwWindow">
    <property name="default-width">400</property>
    <property name="default-height">500</property>
    <property name="modal">True</property>

    <child>
      <object class="GtkShortcutController">
        <child>
          <object class="GtkShortcut">
            <property name="trigger">Escape</property>
            <property name="action">action(window.close)</property>
          </object>
        </child>
      </object>
    </child>

    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwNavigationView" id="navigation_view">

            <!-- Choice between transports, skipped when there is only one -->
            <child>
              <object class="AdwNavigationPage" id="choose_page">
                <property name="tag">choose</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="propagate-natural-height">True</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">360</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                                <property name="margin-start">18</property>
                                <property name="margin-end">18</property>
                                <property name="margin-bottom">18</property>
                                <child>
                                  <object class="GtkLabel" id="choose_title">
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="title-2"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="choose_description">
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <property name="use-markup">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkListBox">
                                    <property name="selection-mode">none</property>
                                    <property name="margin-top">12</property>
                                    <signal name="row-activated" handler="on_transport_row_activated_cb" swapped="yes"/>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                    <child>
                                      <object class="AdwActionRow" id="other_device_row">
                                        <property name="title" translatable="yes">Use Other Device</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">phone-symbolic</property>
                                            <property name="accessible-role">presentation</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkImage">
                                            <property name="icon-name">go-next-symbolic</property>
                                            <property name="accessible-role">presentation</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="security_key_row">
                                        <property name="title" translatable="yes">Use Security Key</property>
                                        <property name="activatable">True</property>
                                        <child type="prefix">
                                          <object class="GtkImage">
                                            <property name="icon-name">credential-security-key-symbolic</property>
                                            <property name="accessible-role">presentation</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkImage">
                                            <property name="icon-name">go-next-symbolic</property>
                                            <property name="accessible-role">presentation</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- QR code for signing in with a phone -->
            <child>
              <object class="AdwNavigationPage">
                <property name="tag">qr</property>
                <property name="title" translatable="yes">Scan QR Code</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="propagate-natural-height">True</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">360</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                                <property name="margin-start">18</property>
                                <property name="margin-end">18</property>
                                <property name="margin-bottom">18</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Scan QR Code</property>
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="title-2"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="qr_description">
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <property name="use-markup">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkStack" id="qr_stack">
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="halign">center</property>
                                    <property name="width-request">200</property>
                                    <property name="height-request">200</property>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">waiting</property>
                                        <property name="child">
                                          <object class="AdwSpinner">
                                            <property name="width-request">32</property>
                                            <property name="height-request">32</property>
                                            <property name="halign">center</property>
                                            <property name="valign">center</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">code</property>
                                        <property name="child">
                                          <object class="GtkPicture" id="qr_picture">
                                            <property name="content-fit">contain</property>
                                            <property name="can-shrink">True</property>
                                            <property name="alternative-text" translatable="yes">QR code</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Make sure both devices are near each other and have Bluetooth enabled</property>
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="CredentialStatusPage">
                <property name="tag">connecting</property>
                <property name="title" translatable="yes">Connecting to Device</property>
                <property name="description" translatable="yes">Make sure both devices are near each other and have Bluetooth enabled</property>
                <property name="icon-name">phone-symbolic</property>
              </object>
            </child>

            <child>
              <object class="CredentialStatusPage" id="other_device_page">
                <property name="tag">other-device</property>
                <property name="title" translatable="yes">Use Other Device</property>
                <property name="icon-name">phone-symbolic</property>
              </object>
            </child>

            <child>
              <object class="CredentialStatusPage" id="connect_key_page">
                <property name="tag">connect-key</property>
                <property name="title" translatable="yes">Connect Security Key</property>
                <property name="icon-name">credential-security-key-symbolic</property>
              </object>
            </child>

            <child>
              <object class="AdwNavigationPage">
                <property name="tag">pin</property>
                <property name="title" translatable="yes">Enter PIN</property>
                <signal name="shown" handler="on_pin_page_shown_cb" swapped="yes"/>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="AdwClamp">
                        <property name="maximum-size">360</property>
                        <property name="valign">start</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-bottom">18</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Enter PIN</property>
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <style>
                                  <class name="title-2"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Enter the PIN to unlock the security key</property>
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox">
                                <property name="selection-mode">none</property>
                                <property name="margin-top">12</property>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                                <child>
                                  <object class="AdwPasswordEntryRow" id="pin_row">
                                    <property name="title" translatable="yes">PIN</property>
                                    <property name="show-apply-button">True</property>
                                    <signal name="apply" handler="on_pin_submitted_cb" swapped="yes"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="pin_status">
                                <property name="visible">False</property>
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <style>
                                  <class name="caption"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Asked when the security key has no PIN yet, or rejected the new one -->
            <child>
              <object class="AdwNavigationPage">
                <property name="tag">set-pin</property>
                <property name="title" translatable="yes">Set PIN</property>
                <signal name="shown" handler="on_set_pin_page_shown_cb" swapped="yes"/>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="AdwClamp">
                        <property name="maximum-size">360</property>
                        <property name="valign">start</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-bottom">18</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Set PIN</property>
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <style>
                                  <class name="title-2"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="set_pin_description">
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox">
                                <property name="selection-mode">none</property>
                                <property name="margin-top">12</property>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                                <child>
                                  <object class="AdwPasswordEntryRow" id="new_pin_row">
                                    <property name="title" translatable="yes">New PIN</property>
                                    <signal name="changed" handler="on_new_pin_changed_cb" swapped="yes"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPasswordEntryRow" id="confirm_pin_row">
                                    <property name="title" translatable="yes">Confirm PIN</property>
                                    <signal name="changed" handler="on_new_pin_changed_cb" swapped="yes"/>
                                    <signal name="entry-activated" handler="on_new_pin_submitted_cb" swapped="yes"/>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="set_pin_button">
                                <property name="label" translatable="yes">_Set PIN</property>
                                <property name="use-underline">True</property>
                                <property name="sensitive">False</property>
                                <property name="margin-top">12</property>
                                <signal name="clicked" handler="on_new_pin_submitted_cb" swapped="yes"/>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Touch or fingerprint, depending on the key -->
            <child>
              <object class="CredentialStatusPage" id="touch_page">
                <property name="tag">touch</property>
              </object>
            </child>

            <child>
              <object class="AdwNavigationPage">
                <property name="tag">choose-passkey</property>
                <property name="title" translatable="yes">Choose Passkey</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="propagate-natural-height">True</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">360</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                                <property name="margin-start">18</property>
                                <property name="margin-end">18</property>
                                <property name="margin-bottom">18</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Choose Passkey</property>
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="title-2"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="passkey_description">
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <property name="use-markup">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkListBox" id="passkey_list">
                                    <property name="selection-mode">none</property>
                                    <property name="margin-top">12</property>
                                    <signal name="row-activated" handler="on_passkey_row_activated_cb" swapped="yes"/>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Errors that end the request -->
            <child>
              <object class="AdwNavigationPage" id="error_page">
                <property name="tag">error</property>
                <property name="can-pop">False</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">False</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="AdwClamp">
                        <property name="maximum-size">360</property>
                        <property name="valign">start</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-bottom">18</property>
                            <child>
                              <object class="GtkLabel" id="error_title">
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <style>
                                  <class name="title-2"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="error_description">
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <property name="use-markup">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="label" translatable="yes">_Close</property>
                                <property name="use-underline">True</property>
                                <property name="margin-top">12</property>
                                <property name="action-name">window.close</property>
                                <style>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
